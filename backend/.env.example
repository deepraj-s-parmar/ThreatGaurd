# FraudShield AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# AI Provider Configuration
# Supported: gemini, openai, fallback
AI_PROVIDER=fallback
AI_MODEL=
AI_API_KEY=

# Google Gemini (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text
# Supported: google, whisper, demo
STT_PROVIDER=demo

# Firebase
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Security
API_KEY=
CORS_ORIGINS=*

AI_PROVIDER=fallback
STT_PROVIDER=demo
FIREBASE_ENABLED=false